# ─── Iron Mallas 2.0 — variables de entorno ───────────────────────────
# Copia este archivo como .env.local. Nunca subas valores reales a Git.

# URL canónica del sitio (metadatos, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Permite indexación fuera de Vercel producción. Déjalo vacío en staging/preview.
SITE_INDEXABLE=

# ─── Fase 2A ────────────────────────────────────────────────────────
# Destino exclusivo de Iron Mallas. No sustituir por proyectos de otros clientes.
NEXT_PUBLIC_SUPABASE_URL=https://kqdcotpfzluxkqdkgyts.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=             # solo servidor, nunca NEXT_PUBLIC_
LEAD_RATE_LIMIT_SECRET=          # secreto aleatorio >=32 caracteres, solo servidor
# RESEND_API_KEY=                 # solo servidor
# LEADS_NOTIFY_EMAIL=
# CAL_WEBHOOK_SECRET=             # solo servidor

# ─── Integraciones y acceso (valores reales solo en .env.local) ──────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_NOTIFY_EMAIL=
CAL_WEBHOOK_SECRET=              # secreto >=32 caracteres configurado también en Cal.com
QUOTE_SHARE_SECRET=              # secreto >=32 caracteres para enlaces PDF con vencimiento
CRON_SECRET=                     # >=32 caracteres; endpoint POST protegido, sin scheduler automático
AUTH_SITE_URL=http://localhost:3000
AUTH_INVITES_CONFIGURED=false    # true solo tras configurar plantillas y redirects Auth
IRONMALLAS_ENV=development       # bootstrap se niega a operar fuera de development
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Migración opcional de medios (script seguro, dry-run por defecto)
MEDIA_MIGRATION_ENV=development
MEDIA_MIGRATION_SUPABASE_URL=
MEDIA_MIGRATION_SUPABASE_SECRET_KEY=

# Meta Lead Ads (formularios instantáneos de Facebook/Instagram). Webhook: /api/webhooks/meta
# Requiere app de Meta con webhook "leadgen" y token de página con permiso leads_retrieval.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
# Lista separada por comas; vacío = todos los formularios de la página
META_LEAD_FORM_IDS=
META_GRAPH_VERSION=v21.0

# WhatsApp Business Platform (Cloud API) · opcional, desactivado por defecto. Webhook: /api/webhooks/whatsapp
# No activar sin verificar la elegibilidad de coexistencia del número comercial.
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Rastreadores opcionales: solo se cargan tras consentimiento en el banner de cookies
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
